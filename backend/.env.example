# ===================================================================
# Hospital Appointment Booking System - Environment Configuration
# ===================================================================

# Database Credentials
DB_URL=jdbc:mysql://localhost:3306/hospital_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# AI Hospital Assistant (Optional)
# If provided, advanced generative query responses can be processed.
# If omitted or offline, the system seamlessly uses the built-in clinical rule & triage engine.
AI_API_KEY=your_gemini_or_openai_api_key_here
